+/*
+ * z158 smooth-touch. A 16-byte event read at 4 us is some 19 bytes x 9 bits x 3 half-cycles, about 2.3 ms spun, and
+ * the loop slept 8 ms between INT checks: under 100 samples a second, bunched (the FTS reports at 120, DT
+ * sync-reportrate-120), at kernel priority on a Gold core next to backboardd.
+ *   pong_touch_i2c_us=N   half-cycle after init (1..45; 0 = as probed). Android drives this bus at 400 kHz (geni default).
+ *   pong_touch_poll_us=N  INT checked every N us while fingers moved in the last 100 ms (default 1000; 0 = 8 ms as before)
+ *   pong_touch_cluster=E  0 (default): the thread prefers the Silver cluster (its spin is bus-bound); -1: no binding
+ */
+static uint32_t touch_i2c_us = 0, touch_poll_us = 1000;
+static int touch_cluster = 0;
+extern void thread_soft_bind_cluster_type(thread_t thread, char cluster_type);
+
+/* USB `touch` (pong_fts_status()): since the last call, event reads and their bus time, coordinate events, and the
+ * time between one finger's move reports (what UIKit sees as the sample rate). One thread writes; a racing read is
+ * at worst off by one sample. */
+static uint32_t st_reads, st_events, st_gaps[5], st_gap_max_us;
+static uint64_t st_read_abs, st_since;
+
+static void
+touch_gap(uint64_t abs)
+{
+	static const uint32_t limit_us[4] = { 6000, 10000, 14000, 20000 };
+	uint64_t ns;
+	unsigned b = 0;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	uint32_t us = ns / NSEC_PER_USEC > UINT32_MAX ? UINT32_MAX : (uint32_t)(ns / NSEC_PER_USEC);
+	if (us >= 100000) {
+		return;                 /* (a pause, not a sample interval) */
+	}
+	while (b < 4 && us >= limit_us[b]) {
+		b++;
+	}
+	st_gaps[b]++;
+	st_gap_max_us = us > st_gap_max_us ? us : st_gap_max_us;
+}
+
+int pong_fts_status(char *out, size_t cap);
+int
+pong_fts_status(char *out, size_t cap)
+{
+	extern uint64_t mach_absolute_time(void);
+	uint64_t now = mach_absolute_time(), ms = 0, read_ns = 0;
+
+	if (st_since != 0) {
+		absolutetime_to_nanoseconds(now - st_since, &ms);
+		ms /= NSEC_PER_MSEC;
+	}
+	absolutetime_to_nanoseconds(st_read_abs, &read_ns);
+	int n = snprintf(out, cap, "touch: %llu ms: %u reads, %llu us each, %u events; move gaps <6 ms %u, <10 %u, <14 %u, <20 %u, "
+	    "longer %u (max %u us) | half-cycle %u us, poll %u us, cluster %d\n", ms, st_reads,
+	    st_reads ? read_ns / NSEC_PER_USEC / st_reads : 0, st_events, st_gaps[0], st_gaps[1], st_gaps[2], st_gaps[3],
+	    st_gaps[4], st_gap_max_us, i2c_delay_us, touch_poll_us, touch_cluster);
+	st_reads = st_events = st_gap_max_us = 0;
+	memset(st_gaps, 0, sizeof(st_gaps));
+	st_read_abs = 0;
+	st_since = now;
+	return n;
+}
 

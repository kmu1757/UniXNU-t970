@@ -844,6 +928,11 @@ fts_touch_thread(__unused void *param, __unused wait_result_t wr)
 
 					pong_touch_post(action, tid, post_x, post_y);
 					pong_cpu_perf_input();     /* governor input boost (modes 3, 4) */
+					if (action == FTS_ACT_MOVE && last_touch != 0) {

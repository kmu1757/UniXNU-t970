+static void
+nap_us(uint32_t us)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(us, NSEC_PER_USEC, &deadline);
+	assert_wait_deadline((event_t)&tlmm_vaddr, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}

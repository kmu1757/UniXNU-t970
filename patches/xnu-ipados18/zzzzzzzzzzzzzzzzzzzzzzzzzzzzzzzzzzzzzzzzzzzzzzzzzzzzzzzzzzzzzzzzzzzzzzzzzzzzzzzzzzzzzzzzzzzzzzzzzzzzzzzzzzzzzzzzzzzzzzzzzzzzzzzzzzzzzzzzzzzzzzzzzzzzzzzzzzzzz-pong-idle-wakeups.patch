+/*
+ * A touch or pen event (pong_fts.c): every domain goes to its cap now, not at the next 50 ms sample, and stays
+ * there for pong_cpu_boost ms (default 1000, 0 = no boost) after the last event -- what stock iOS and Android do,
+ * so the first frames of a drag do not run at the lowest clock. Nothing happens in modes 1 and 2 or in the dark.
+ */
+void
+pong_cpu_perf_input(void)
+{
+	if (g_mode < 3 || g_boost_span == 0 || pong_dark_idle()) {
+		return;
+	}
+	const uint64_t now = mach_absolute_time();
+	const bool was = now < __atomic_load_n(&g_boost_until, __ATOMIC_RELAXED);
+
+	__atomic_store_n(&g_boost_until, now + g_boost_span, __ATOMIC_RELAXED);
+	if (was) {
+		return;
+	}
+	g_boosts++;
+	for (unsigned d = 0; d < EPSS_NUM_DOMAINS; d++) {
+		if (g_base[d] && g_row[d] != g_cap[d]) {
+			*(volatile uint32_t *)(g_base[d] + EPSS_REG_PERF_STATE) = g_cap[d];
+			g_row[d] = g_cap[d];
+			g_writes++;
+		}
+	}
+}

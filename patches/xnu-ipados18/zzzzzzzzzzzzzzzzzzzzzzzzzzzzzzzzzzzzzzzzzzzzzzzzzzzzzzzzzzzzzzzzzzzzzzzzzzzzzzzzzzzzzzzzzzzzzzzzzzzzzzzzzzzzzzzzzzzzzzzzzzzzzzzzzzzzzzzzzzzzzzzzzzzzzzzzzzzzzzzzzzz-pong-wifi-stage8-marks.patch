diff --git a/bsd/dev/pong_wifi_link.c b/bsd/dev/pong_wifi_link.c
index 31a8fa7..50b4da3 100644
--- a/bsd/dev/pong_wifi_link.c
+++ b/bsd/dev/pong_wifi_link.c
@@ -3919,11 +3919,43 @@ pong_wifi_stage4(char *reply, size_t reply_len, int what)
 volatile void *pong_wifi_ep_cfg(unsigned int off);
 void pong_wifi_stack_table(uint64_t table_pa);
 
-/* The endpoint's configuration space, one of the windows `wifiup` mapped. */
+/*
+ * The endpoint's configuration space, one of the windows `wifiup` mapped. Only while the link is up: a request
+ * with no link is never answered and stalls the bus (rui T970WifiStack.cpp), which looks like a whole-tablet hang
+ * with no panic (11-17 half95f1 after `s3b w3`). Checked on the root port's own registers (no request on the
+ * wire): GDSC and clocks running, PARF LTSSM enable, DBI link up, data link layer active. Any LTSSM state of a
+ * trained link passes (L1 wakes up for the request). The first refusals go to pmsg with what was seen.
+ */
 volatile void *
 pong_wifi_ep_cfg(unsigned int off)
 {
-	return off < 4096u ? (volatile void *)wl_ptr(CFGSPACE + off) : NULL;
+	static unsigned refused;
+	uint32_t gdsc = 0, halt = 0, ltssm = 0, dbg0 = 0, dbg1 = 0, lnk = 0;
+
+	if (off >= 4096u) {
+		return NULL;
+	}
+	if (wl_is_up && ((gdsc = rd(GCC_PCIE0_GDSCR)) & (1u << 31)) &&
+	    !((halt = wl_halt()) & (WL_HALT_PARF | WL_HALT_DBI))) {
+		ltssm = rd(PARF_LTSSM);
+		dbg0 = rd(DBI_DEBUG0);
+		dbg1 = rd(DBI_DEBUG1);
+		lnk = rd(DBI_LNKCTL);
+		if ((ltssm & (1u << 8)) && (dbg1 & (1u << 4)) && (lnk & (1u << 29))) {
+			return (volatile void *)wl_ptr(CFGSPACE + off);
+		}
+	}
+	if (refused++ < 4) {
+		char line[160];
+		int n = snprintf(line, sizeof(line),
+		    "[PONG_WIFI] epcfg nolink nolink off %x up %d gdsc %x halt %x ltssm %x dbg0 %x dbg1 %x lnk %x\n",
+		    off, wl_is_up, gdsc, halt, ltssm, dbg0, dbg1, lnk);
+
+		if (n > 0) {
+			pong_ramoops_diagnostic_write(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+		}
+	}
+	return NULL;
 }
 

 		}
 		IODelay(100);
@@ -1313,6 +1325,10 @@ dpuReport(char * out, size_t cap)
 	DPU_SAY("flip: %s, %u buffers %llx %llx %llx, pipes %x ctl %d flush bits %x, scaled %d/%d, shown %d pending %d newest %d; "

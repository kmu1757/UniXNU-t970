+A650GmuStatus A650GmuVotePerf(A650GmuDevice *d, unsigned perf_index, uint32_t *firmware_error)
+{
+    if (!d || !firmware_error || perf_index < 1 || perf_index > 7) return A650GmuArgument;
+    *firmware_error = 0;
+    if (d->poisoned || d->hfi.poisoned) return A650GmuPoisoned;
+    if (!d->startup.completed) return A650GmuStateMismatch;
+    const uint32_t vote[3] = {1, perf_index, A650GmuDdrVote ? 1u : 0u};
+    uint32_t out[16]; size_t count = 0;
+    const AdrenoHfiStatus s = AdrenoHfiExchange(&d->hfi, 30, vote, 3, 1000, hfi_wait, out, 16, &count, firmware_error);
+    return s == AdrenoHfiSuccess ? A650GmuSuccess : s == AdrenoHfiFirmwareError ? A650GmuProtocolError : A650GmuTimeout;
+}

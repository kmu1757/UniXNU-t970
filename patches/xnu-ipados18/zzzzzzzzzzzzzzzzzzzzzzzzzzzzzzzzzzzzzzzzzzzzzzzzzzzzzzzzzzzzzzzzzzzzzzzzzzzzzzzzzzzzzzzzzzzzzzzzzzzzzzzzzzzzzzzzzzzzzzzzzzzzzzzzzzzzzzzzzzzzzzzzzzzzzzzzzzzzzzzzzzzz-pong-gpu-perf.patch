+/* perf 1..7 sets the target (starting the thread once GX is on); any other value only reports */
+int
+pong_gpu_gmu_perf(int perf, char *reply, size_t cap)
+{
+	static const uint16_t mhz[8] = {0, 305, 400, 441, 490, 525, 587, 670};
+
+	if (perf >= 1 && perf <= 7) {
+		if (!gg_gx_ok) {
+			snprintf(reply, cap, "gpuperf: stop=gx_off\n");
+			return -1;
+		}
+		gp_target = (uint32_t)perf;
+		if (OSCompareAndSwap(0, 1, &gp_started)) {
+			thread_t th = THREAD_NULL;
+
+			(void)PE_parse_boot_argn("pong_thermal_c", &gp_limit, sizeof(gp_limit));
+			if (kernel_thread_start(gp_thread, NULL, &th) == KERN_SUCCESS) {
+				thread_deallocate(th);
+			}
+		}
+	}
+	snprintf(reply, cap, "gpuperf: level=%u (%u MHz) target=%u ddr=%u hot=%d.%dC limit=%uC votes=%u throttles=%u err=%u fw=%#x thread=%u\n",
+	    gp_level, mhz[gp_level & 7], gp_target, A650GmuDdrVote, gp_hot / 10, (gp_hot < 0 ? -gp_hot : gp_hot) % 10, gp_limit, gp_votes,
+	    gp_throttles, gp_err, gp_fwerr, gp_started);
+	return 0;
+}

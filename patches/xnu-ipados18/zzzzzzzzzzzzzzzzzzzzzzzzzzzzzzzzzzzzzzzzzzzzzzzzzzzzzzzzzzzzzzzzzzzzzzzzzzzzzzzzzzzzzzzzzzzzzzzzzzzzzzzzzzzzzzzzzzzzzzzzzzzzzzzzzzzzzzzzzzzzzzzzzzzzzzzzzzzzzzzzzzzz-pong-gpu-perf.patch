+/*
+ * z162: the GPU level. GX comes up at level 1 (305 MHz), as before. Boot-arg pong_gpu_perf=N (2..7: 400, 441.6, 490, 525, 587,
+ * 670 MHz) or USB `gpuprobe perf N` sets a target; a thread then climbs one level per 500 ms toward it and, like the CPU governor,
+ * steps one level down per 500 ms while the hottest TSENS bank-0 sensor (CPU cores, cpuss, gpuss-0) is above pong_thermal_c
+ * (default 85 C), holding within 5 C of it. The thread alone sends the votes (A650GmuVotePerf). pong_gpu_ddr=1 (before gmustart)
+ * gives the bandwidth table its top DDR level, voted with every level. No DCVS: the level holds while the GPU idles.
+ */
+extern int pong_tsens_hot_dc(void);
+static volatile uint32_t gp_target = 1, gp_started;
+static uint32_t gp_level = 1, gp_votes, gp_throttles, gp_err, gp_fwerr, gp_limit = 85;
+static volatile int gp_hot = -32768;
+
+static void
+gp_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		const int hot = pong_tsens_hot_dc();
+		uint32_t want = gp_level < gp_target ? gp_level + 1 : gp_target;
+
+		gp_hot = hot;
+		if (hot > (int)gp_limit * 10) {
+			want = gp_level > 1 ? gp_level - 1 : 1;
+			gp_throttles += want < gp_level;
+		} else if (hot >= ((int)gp_limit - 5) * 10 && want > gp_level) {
+			want = gp_level;
+		}
+		if (want != gp_level) {
+			uint32_t fw = 0;
+			const A650GmuStatus st = A650GmuVotePerf(&gg.dev, want, &fw);
+
+			if (st == A650GmuSuccess) {
+				gp_level = want;
+				gp_votes++;
+			} else {
+				gp_err = (uint32_t)st;
+				gp_fwerr = fw;
+				if (st == A650GmuPoisoned || st == A650GmuTimeout) {
+					return;   /* the HFI session is gone: the level stays where it is */
+				}
+			}
+		}
+		delay_for_interval(500, 1000000u);
+	}
+}

+	    gArIdleMs, gArActive, gArNow, gArDowns, gArUps);
 	DPU_SAY("120hz: fb_120hz %u, DCS 60 20 answer %d, intf1 sync_config_vsync %x -> %x now %x; adaptive: at %s, %u up %u down %u failed, "
 	    "frames every %llu us\n", g120Hz, g120Sent, g120Sync[0], g120Sync[1], mdssRead(MDSS_INTF1 + INTF_TEAR_SYNC_CONFIG_VSYNC),
 	    gRateFast ? "120" : "60", gRateUp, gRateDown, gRateFailed, gRateAvgUs);
@@ -2061,6 +2162,9 @@ IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
 			}
 		}
 	}
+	if (drew && gArIdle != 0) {
+		panelArFrame(began);            /* (fb_ar_idle: every TE again, when things move, before the frame is flipped to or sent) */
+	}
 	if (drew && back >= 0) {
 		panelFlip((unsigned) back);     /* (on show from the next frame's start) */
 	}

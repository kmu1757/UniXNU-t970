+/*
+ * Boot-arg fb_ar_idle=N (0, the default: off): while nothing moves, INTF1 sends the panel a frame on
+ * every N-th TE pulse only (a command-mode panel keeps showing what it has; DSI, DSC and the panel's
+ * input are busy only for what is sent). A still screen still gets a frame some every 50 ms (11-17):
+ * those go out at the idle count, at most N TE pulses late. Moving -- two frame intervals in a row under
+ * fb_ar_active_us (30000), as fb_120hz=3 tells it -- puts back the count it had (every TE with
+ * fb_autorefresh=1 or fb_120hz) until fb_ar_idle_ms (1000) after the last moving frame. fb_ar_off=M: M
+ * instead of N while the display is off (z104's DCS 0x28, pong_panel_is_off()); 0: N. Only the frame
+ * count is changed, as fb_autorefresh does it (the work/gap_audit/POWER_ANALYSIS.md request, 11-17).
+ */
+static TUNABLE(uint32_t, gArIdle, "fb_ar_idle", 0);
+static TUNABLE(uint32_t, gArOff, "fb_ar_off", 0);
+static TUNABLE(uint32_t, gArIdleMs, "fb_ar_idle_ms", 1000);
+static TUNABLE(uint32_t, gArActiveUs, "fb_ar_active_us", 30000);
+static IOLock *         gArLock;
+static thread_call_t    gArCall;
+static uint32_t         gArActive, gArNow;      /* the count while frames come; the count now */
+static uint32_t         gArDowns, gArUps, gArShort;
+static uint64_t         gArLast;
+
+/* INTF1's autorefresh count to `count` (it stays on). With gArLock held. */
+static void
+panelArSet(uint32_t count)
+{
+	uint32_t config;
+
+	if (count == 0 || count > 0xffff || count == gArNow || !panelAlive("autorefresh")) {
+		return;
+	}
+	config = mdssRead(MDSS_INTF1 + INTF_TEAR_AUTOREFRESH);
+	if (!(config & AUTOREFRESH_ON)) {
+		return;
+	}
+	mdssWrite(MDSS_INTF1 + INTF_TEAR_AUTOREFRESH, AUTOREFRESH_ON | count);
+	gArNow = count;
+}
+
+/* No frame for fb_ar_idle_ms: the idle count (or the display-off one); looked at again while idle, for the display going off. */
+static void
+panelArIdle(thread_call_param_t, thread_call_param_t)
+{
+	uint64_t deadline;
+	uint32_t want = pong_panel_is_off() && gArOff != 0 ? gArOff : gArIdle;
+
+	IOLockLock(gArLock);
+	if (gArNow != want) {
+		panelArSet(want);
+		gArDowns++;
+	}
+	IOLockUnlock(gArLock);
+	clock_interval_to_deadline(gArIdleMs, kMillisecondScale, &deadline);
+	thread_call_enter_delayed(gArCall, deadline);
+}
+
+static void
+panelArInit(void)
+{
+	gArActive = gArNow = mdssRead(MDSS_INTF1 + INTF_TEAR_AUTOREFRESH) & 0xffff;
+	gArLock = IOLockAlloc();
+	gArCall = thread_call_allocate(panelArIdle, NULL);
+	if (gArLock == NULL || gArCall == NULL || gArActive == 0) {
+		gArCall = NULL;
+		return;
+	}
+	IOLog("MiniIOMobileFramebuffer: dpu: fb_ar_idle=%u: autorefresh %u while frames come, %u after %u ms without one (%u display off)\n",
+	    gArIdle, gArActive, gArIdle, gArIdleMs, gArOff ? gArOff : gArIdle);
+	panelArIdle(NULL, NULL);
+}
+
+/* A frame drawn at `now` is about to go to the panel: if things move, every TE again, idle fb_ar_idle_ms after the last such frame. */
+static void
+panelArFrame(uint64_t now)
+{
+	uint64_t us, deadline;
+	bool moving;
+
+	if (gArCall == NULL) {
+		return;
+	}
+	IOLockLock(gArLock);
+	us = gArLast != 0 ? micros(now) - micros(gArLast) : 0;
+	gArLast = now;
+	gArShort = us != 0 && us < gArActiveUs ? gArShort + 1 : 0;
+	/* (and the first frame after the display-off count: a flip must be taken within PANEL_LATCH_MS) */
+	moving = gArShort >= 2 || (gArNow != gArActive && gArNow != gArIdle);
+	if (moving && gArNow != gArActive) {
+		panelArSet(gArActive);
+		gArUps++;
+	}
+	IOLockUnlock(gArLock);
+	if (moving) {
+		clock_interval_to_deadline(gArIdleMs, kMillisecondScale, &deadline);
+		thread_call_enter_delayed(gArCall, deadline);
+	}
+}
+

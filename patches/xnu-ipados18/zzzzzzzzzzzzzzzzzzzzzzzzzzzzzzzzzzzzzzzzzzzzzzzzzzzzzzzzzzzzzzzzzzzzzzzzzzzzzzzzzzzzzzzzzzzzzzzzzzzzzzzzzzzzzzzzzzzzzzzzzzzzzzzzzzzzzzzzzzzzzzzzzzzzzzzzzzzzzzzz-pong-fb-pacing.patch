+/*
+ * fb_vsync_lock=1 (default 0, z160): the refresh notifications CoreAnimation paces itself by (armVSync) and fb_beat
+ * run at the panel's clock, not at exactly 1/refreshHz of ours. The panel's TE comes from its own oscillator; ours off
+ * from it by x makes one frame in every 1/(120 x) s go out twice or not at all -- a stutter every so many seconds of
+ * scrolling. Measured on INTF1's frame counter: while the TE rate (60/120) and the autorefresh count stay the same,
+ * frames x count / rate is the time our clock should have seen; segments of 1 s or more (closed every 10 s) are summed
+ * and the difference kept in millionths. Only the period changes, not the phase. USB `dpu`: the "vsync lock:" line.
+ */
+static TUNABLE(uint32_t, gVsyncLock, "fb_vsync_lock", 0);
+static uint64_t         gLockActual, gLockExpected; /* over the segments: our clock's time, the panel's frames' (abs) */
+static uint32_t         gLockSegments;
+static int32_t          gLockPpm;                   /* our period longer by so many millionths (the panel is slower) */
+
+static uint32_t
+panelTeHz(void)
+{
+	if (g120Hz == 3) {
+		return gRateFast ? 120 : 60;
+	}
+	return (g120Hz == 1 || g120Hz == 2) && g120Sent == 0 ? 120 : 60;
+}
+
+/* One look at INTF1's frame counter, from the refresh notification (about refreshHz a second, maybe more clients). */
+static void
+vsyncLockSample(void)
+{
+	static int busy;
+	static uint32_t f0, pf, hz0, n0;
+	static uint64_t t0, pt, onesec;
+	uint32_t power[6], f, n, hz;
+	uint64_t t;
+	bool same;
+
+	if (!gVsyncLock || __atomic_exchange_n(&busy, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	if (!dpuMap() || !dpuPowered(power)) {
+		t0 = 0;
+		__atomic_store_n(&busy, 0, __ATOMIC_RELEASE);
+		return;
+	}
+	f = mdssRead(MDSS_INTF1 + INTF_FRAME_COUNT);
+	n = mdssRead(MDSS_INTF1 + INTF_TEAR_AUTOREFRESH);
+	n = (n & AUTOREFRESH_ON) ? n & 0xffff : 0;
+	hz = panelTeHz();
+	t = mach_absolute_time();
+	if (onesec == 0) {
+		nanoseconds_to_absolutetime(NSEC_PER_SEC, &onesec);
+	}
+	same = t0 != 0 && n == n0 && hz == hz0 && f >= pf;
+	if (same) {
+		pf = f;
+		pt = t;
+	}
+	if (!same || t - t0 >= 10 * onesec) {
+		/* the segment ends at the last sample of the same mode: counted when 1 s or longer */
+		if (t0 != 0 && n0 != 0 && hz0 != 0 && pt - t0 >= onesec && pf > f0) {
+			gLockActual += pt - t0;
+			gLockExpected += (uint64_t) (pf - f0) * n0 * onesec / hz0;
+			gLockSegments++;
+			if (gLockExpected > 600 * onesec) {
+				gLockActual /= 2;       /* (the last ten minutes or so count most) */
+				gLockExpected /= 2;
+			}
+			if (gLockExpected >= 2 * onesec) {
+				int64_t ppm = ((int64_t) gLockActual - (int64_t) gLockExpected) * 1000000 / (int64_t) gLockExpected;
+				/* (beyond 2 % it is not the clock but a mode taken for another) */
+				gLockPpm = ppm > 20000 || ppm < -20000 ? gLockPpm : (int32_t) ppm;
+			}
+		}
+		f0 = pf = f;
+		t0 = pt = t;
+		hz0 = hz;
+		n0 = n;
+	}
+	__atomic_store_n(&busy, 0, __ATOMIC_RELEASE);
+}
+
+/* One refresh at refreshHz, on the panel's clock with fb_vsync_lock. */
+static uint64_t
+vsyncPeriod(void)
+{
+	uint64_t period;
+
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / refreshHz(), &period);
+	if (gVsyncLock) {
+		period = (uint64_t) ((int64_t) period + (int64_t) period * gLockPpm / 1000000);
+	}
+	return period;
+}
